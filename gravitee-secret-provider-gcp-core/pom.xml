<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.fluenthealth.gravitee.secretprovider</groupId>
        <artifactId>gravitee-secret-provider-gcp-project</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>gravitee-secret-provider-gcp-core</artifactId>
    <name>Fluent Health - Gravitee Secret Provider - GCP - Core</name>
    <description>GCP Secret Manager access: the only GCP-aware code in this project</description>

    <dependencies>
        <!--
          Deliberately NOT google-cloud-secretmanager. That client drags a large
          gRPC/protobuf/Guava tree which would have to be bundled into the plugin ZIP's
          lib/ and is a likely classloader conflict with the gateway's own Guava and Netty.
          The Secret Manager REST API over the Vert.x WebClient the gateway already ships
          needs no bundled dependencies at all.
        -->
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-web-client</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-rx-java3</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.reactivex.rxjava3</groupId>
            <artifactId>rxjava</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.gravitee.secret</groupId>
            <artifactId>gravitee-secret-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- SecretURL exposes its query string as a Guava Multimap. -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
